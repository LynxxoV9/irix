# IRYX Environment Configuration
# Project: The Piercing Eye of Incident Response

# Environment: development | production | testing
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (PostgreSQL in production, SQLite fallback in dev/test)
# PostgreSQL example: postgresql://iryx:iryx_password@localhost:5432/iryx_db
DATABASE_URL=sqlite:///./data/iryx.db

# Storage configuration for raw evidence & extracted artifacts
STORAGE_DIR=./data/artifacts

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001

# =========================================================================
# PASSERELLE LLM PLUG & PLAY (RhodiumAI, Nebius Token Factory, Groq, etc.)
# Compatible API OpenAI standard (chat/completions)
# =========================================================================
THE_API_KEY=
LLM_BASE_URL=https://api.rhodium.ai/v1
LLM_FAST_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_DEEP_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Threat Intelligence (Tavily)
TAVILY_API_KEY=
